# ── Obrigatório ────────────────────────────────────────────────────────────────
# Chave da API do Google Gemini (assistente de IA)
GEMINI_API_KEY="sua_chave_gemini_aqui"

# Segredo de sessão - OBRIGATÓRIO em produção (mínimo 32 caracteres aleatórios)
# Gere com: openssl rand -base64 32
SESSION_SECRET="troque_por_string_aleatoria_longa_em_producao"

# ── Ambiente ───────────────────────────────────────────────────────────────────
NODE_ENV="production"   # "development" em dev local

# ── Rede ───────────────────────────────────────────────────────────────────────
# Porta do servidor (default: 5000 - Heroku/Render sobrescrevem automaticamente)
PORT=5000

# Origens CORS permitidas em produção (separadas por vírgula, deixe vazio para same-origin)
# Exemplo: https://paflegis.com,https://www.paflegis.com
ALLOWED_ORIGINS=""

# ── Opcional ───────────────────────────────────────────────────────────────────
# TTL do cache de estatísticas em ms (default: 5 minutos)
STATS_TTL_MS=300000
