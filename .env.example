# ==============================================================================
# PAFLEGIS — Variáveis de Ambiente & Configuração da Aplicação
# ==============================================================================
# Todas as variáveis possuem fallbacks sensatos e validação automática.
# Para utilizar outro SAPL, basta alterar SAPL_API_BASE.

# ------------------------------------------------------------------------------
# 1. CONEXÃO COM O SAPL UPSTREAM
# ------------------------------------------------------------------------------
# [OBRIGATÓRIO para outras câmaras / OPCIONAL para Pedro Afonso]
# URL base da API REST do SAPL oficial.
# Padrão: https://sapl.pedroafonso.to.leg.br/api
SAPL_API_BASE=https://sapl.pedroafonso.to.leg.br/api

# [OPCIONAL]
# Domínio público do portal do SAPL para links de fontes oficiais e mídia.
# Se omitido, é deduzido automaticamente a partir de SAPL_API_BASE.
# Padrão: https://sapl.pedroafonso.to.leg.br
SAPL_PUBLIC_DOMAIN=https://sapl.pedroafonso.to.leg.br

# [OPCIONAL]
# IP de origem interno retornado nas respostas do SAPL para ser sanitizado.
# Padrão: 64.23.167.191 (qualquer outro IPv4 também é detectado e substituído dinamicamente)
SAPL_ORIGIN_IP=64.23.167.191

# ------------------------------------------------------------------------------
# 2. IDENTIDADE DA CASA LEGISLATIVA E DO PORTAL CÍVICO
# ------------------------------------------------------------------------------
# Se omitidas, essas variáveis são DESCOBERTAS AUTOMATICAMENTE via /base/casalegislativa/
# e preenchem títulos, rodapé, Open Graph e sitemap.

# [OPCIONAL] Nome do portal cívico. Padrão: "Paflegis · Pedro Afonso"
SITE_NAME=Paflegis · Pedro Afonso

# [OPCIONAL] Descrição do portal.
SITE_DESCRIPTION=Portal cívico independente de consulta e transparência legislativa municipal.

# [OPCIONAL] Nome oficial da instituição. Padrão: "Câmara Municipal de Pedro Afonso"
ORG_NAME=Câmara Municipal de Pedro Afonso

# [OPCIONAL] Sigla da instituição. Padrão: "CMPA"
ORG_ACRONYM=CMPA

# [OPCIONAL] Município da casa legislativa. Padrão: "Pedro Afonso"
ORG_CITY=Pedro Afonso

# [OPCIONAL] Unidade Federativa (UF). Padrão: "TO"
ORG_UF=TO

# ------------------------------------------------------------------------------
# 3. DOMÍNIO PÚBLICO E SEGURANÇA DE REDE
# ------------------------------------------------------------------------------
# [OPCIONAL]
# URL pública canônica em que o app está servido.
# Se omitida, é resolvida automaticamente via variáveis de ambiente da plataforma
# (VERCEL_PROJECT_PRODUCTION_URL, VERCEL_URL, Cloud Run/AI Studio) ou cabeçalho Host.
APP_PUBLIC_URL=https://paflegis.vercel.app

# [OPCIONAL]
# Lista de hosts permitidos separados por vírgula para validação do cabeçalho Host.
# Padrão: vazio (aceita qualquer host válido)
ALLOWED_HOSTS=

# [OPCIONAL]
# Origens adicionais permitidas no CORS para consumo da API pública /api/*
# Padrão: vazio (a origem do próprio app é sempre autorizada automaticamente)
CORS_ALLOWED_ORIGINS=

# [OPCIONAL]
# Se true, confia nos cabeçalhos x-forwarded-for e x-real-ip para contagem de rate limit.
# Recomendado para deploys atrás de reverse proxy (Cloud Run, Vercel, Nginx, Docker).
# Padrão: true em produção, false em desenvolvimento
TRUST_PROXY=true

# ------------------------------------------------------------------------------
# 4. AUTENTICAÇÃO E CONTROLE DE ACESSO DA API NATIVA
# ------------------------------------------------------------------------------
# [OPCIONAL]
# Modo de acesso da API pública:
# - "open": leitura pública liberada para clientes externos com rate limit por IP.
# - "keyed": chave de API obrigatória para requisições externas via query string ?API_KEYS= ou cabeçalho x-api-key.
# Padrão: "keyed" (API protegida por API Key definida no ambiente).
API_ACCESS_MODE=keyed

# [OPCIONAL]
# Nome oficial para chaves de API autorizadas (separadas por vírgula).
# Suporta:
# 1. Chaves em texto puro: "chave1,chave2"
# 2. Hashes SHA-256: "sha256:9f86d081884c7d659a2feaa0c55ad015a3bf4f1b2b0b822cd15d6c15b0f00a08"
# 3. Metadados nome:chave:escopo: "app_mobile:chave123:leitura,portal:sha256_hash:*"
API_KEYS_PERMITIDAS=sk_1724ebeae5b8b48215cf762ca8bb2a0c

# [OPCIONAL / LEGADO]
# Alias mantido exclusivamente para compatibilidade retroativa.
# Se preenchido, emite aviso no log recomendando migrar para API_KEYS_PERMITIDAS.
API_KEYS=sk_1724ebeae5b8b48215cf762ca8bb2a0c

# [OPCIONAL / RECOMENDADO EM PRODUÇÃO]
# Segredo utilizado na assinatura HMAC-SHA256 do cookie seguro de sessão do frontend.
# Se omitido, um segredo aleatório persistente é gerado na inicialização.
SESSION_SECRET=

# [OPCIONAL / RECOMENDADO EM PRODUÇÃO]
# Segredo para autorizar execuções agendadas de sincronização em POST /api/v1/sync.
# Enviado no cabeçalho: Authorization: Bearer <CRON_SECRET> ou x-cron-secret: <CRON_SECRET>.
# Padrão: "paflegis-sync-secret-default"
CRON_SECRET=

# ------------------------------------------------------------------------------
# 5. CAMADA DE ARMAZENAMENTO E PERSISTÊNCIA (STORAGE)
# ------------------------------------------------------------------------------
# [OPCIONAL]
# Driver de persistência para cache, espelho local de dados e contadores atômicos.
# Opções: "sqlite" (nativo Node 22), "file" (JSON atômico), "memory" (volátil).
# Padrão: "sqlite"
STORAGE_DRIVER=sqlite

# [OPCIONAL]
# Diretório em disco onde banco de dados SQLite e arquivos de mídia são salvos.
# Padrão: ".data"
STORAGE_PATH=.data

# [OPCIONAL]
# Habilita espelhamento local e download em background de arquivos de mídia (PDFs, anexos).
# Padrão: false
MIRROR_MEDIA=false

# [OPCIONAL]
# Tamanho máximo em bytes para espelhamento de documento individual.
# Padrão: 52428800 (50 MB)
MAX_MEDIA_BYTES=52428800

# ------------------------------------------------------------------------------
# 6. ENVIO DE E-MAIL (SMTP GMAIL — FORMULÁRIO DE CONTATO)
# ------------------------------------------------------------------------------
# Se omitidos, as mensagens recebidas são registradas no log com protocolo atômico YYYY-NNNNNN
# sem falhar a interface do usuário.

# [OPCIONAL] Conta Gmail autenticada no Nodemailer
EMAIL_USER=

# [OPCIONAL] Senha de aplicativo de 16 caracteres do Google (gerada no painel de segurança)
EMAIL_APP_PASSWORD=

# [OPCIONAL] E-mail de destino da ouvidoria/suporte que receberá as mensagens
EMAIL_DESTINO=

# ------------------------------------------------------------------------------
# 7. INTELIGÊNCIA ARTIFICIAL CÍVICA (GOOGLE GEMINI)
# ------------------------------------------------------------------------------
# [OPCIONAL]
# Chave da API Google Gemini para geração de resumos automatizados de matérias
# em linguagem simples para o cidadão no endpoint /api/v1/ai/resumo.
GEMINI_API_KEY=