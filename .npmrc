registry=https://registry.npmjs.org

# Limita conexões simultâneas — evita o bug "Exit handler never called" do npm 10.9.x
# causado por flood de requests ao baixar pacotes opcionais multiplataforma (rollup, esbuild).
maxsockets=5
fetch-retry-mintimeout=20000
fetch-retry-maxtimeout=120000
fetch-timeout=120000
